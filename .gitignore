__pycache__/
*.py[cod]
*.swp
FETCH_HEAD

# Ignore original large terrain datasets
data/terrain/*.tif
data/terrain/**/*.tif
data/terrain/**/*.tiff
data/terrain/**/*.IMG
data/terrain/**/*.img

# Allow compact deployment terrain tiles
!data/terrain/deployment/
!data/terrain/deployment/**/*.tif
!data/terrain/deployment/**/*.tiff